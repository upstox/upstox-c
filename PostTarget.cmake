# Hand-written build additions, included by the generated CMakeLists.txt after the upstox_client target.

find_package(Threads REQUIRED)

# Feeder: websocket streamers in a separate library, so the REST client does not need protobuf-c
file(GLOB UPSTOX_FEEDER_SRCS ${PROJECT_SOURCE_DIR}/upstox_client/feeder/*.c ${PROJECT_SOURCE_DIR}/upstox_client/feeder/marketdatav3/*.c ${PROJECT_SOURCE_DIR}/upstox_client/feeder/marketdatav3/google/protobuf/*.c)
list(REMOVE_ITEM UPSTOX_FEEDER_SRCS ${PROJECT_SOURCE_DIR}/upstox_client/feeder/feeder_test.c)
# The feeder uses pthreads, poll and POSIX sockets, so it is not built on Windows (use WSL)
if(UPSTOX_FEEDER_SRCS AND NOT WIN32)
    find_path(PROTOBUF_C_INCLUDE_DIR protobuf-c/protobuf-c.h HINTS /opt/homebrew/include /usr/local/include)
    find_library(PROTOBUF_C_LIBRARY NAMES protobuf-c HINTS /opt/homebrew/lib /usr/local/lib)
    if(PROTOBUF_C_INCLUDE_DIR AND PROTOBUF_C_LIBRARY)
        add_library(upstox_feeder ${UPSTOX_FEEDER_SRCS})
        target_include_directories(upstox_feeder PUBLIC ${PROTOBUF_C_INCLUDE_DIR})
        # wrappers.pb-c.c includes "google/protobuf/wrappers.pb-c.h" relative to marketdatav3/
        target_include_directories(upstox_feeder PRIVATE ${PROJECT_SOURCE_DIR}/upstox_client/feeder/marketdatav3)
        target_link_libraries(upstox_feeder PUBLIC ${pkgName} ${PROTOBUF_C_LIBRARY} Threads::Threads)
        install(TARGETS upstox_feeder DESTINATION lib)
        install(DIRECTORY ${PROJECT_SOURCE_DIR}/upstox_client/feeder/ DESTINATION include/upstox_client/feeder
                FILES_MATCHING PATTERN "*.h" PATTERN "streamer_internal.h" EXCLUDE)
    else()
        message(WARNING "protobuf-c not found; skipping the upstox_feeder library")
    endif()
endif()

# Unit tests (no network); the local HTTP listener uses POSIX sockets
enable_testing()
if(NOT WIN32)
    add_executable(upstox_test ${PROJECT_SOURCE_DIR}/upstox_client/upstox_test.c)
    target_link_libraries(upstox_test PRIVATE ${pkgName} Threads::Threads)
    add_test(NAME upstox_test COMMAND upstox_test)
endif()
if(TARGET upstox_feeder AND EXISTS ${PROJECT_SOURCE_DIR}/upstox_client/feeder/feeder_test.c)
    add_executable(feeder_test ${PROJECT_SOURCE_DIR}/upstox_client/feeder/feeder_test.c)
    target_link_libraries(feeder_test PRIVATE upstox_feeder Threads::Threads)
    add_test(NAME feeder_test COMMAND feeder_test)
endif()

# Live sanity programs, the counterparts of Python's sanity.py and sandbox_sanity.py
foreach(prog sanity sandbox_sanity)
    if(EXISTS ${PROJECT_SOURCE_DIR}/test/sdk_tests/${prog}.c)
        add_executable(${prog} ${PROJECT_SOURCE_DIR}/test/sdk_tests/${prog}.c)
        target_link_libraries(${prog} PRIVATE ${pkgName})
    endif()
endforeach()

# Runnable example programs (strategies and websocket)
option(UPSTOX_BUILD_EXAMPLES "Build the runnable example programs" OFF)
if(UPSTOX_BUILD_EXAMPLES)
    file(GLOB_RECURSE UPSTOX_EXAMPLE_SRCS ${PROJECT_SOURCE_DIR}/examples/strategies/*.c ${PROJECT_SOURCE_DIR}/examples/websocket/*.c)
    foreach(src ${UPSTOX_EXAMPLE_SRCS})
        file(RELATIVE_PATH rel ${PROJECT_SOURCE_DIR}/examples ${src})
        string(REGEX REPLACE "[/.]" "_" name ${rel})
        string(REGEX REPLACE "_c$" "" name ${name})
        add_executable(example_${name} ${src})
        if(rel MATCHES "^websocket/")
            if(TARGET upstox_feeder)
                target_link_libraries(example_${name} PRIVATE upstox_feeder)
            else()
                set_target_properties(example_${name} PROPERTIES EXCLUDE_FROM_ALL ON)
            endif()
        else()
            target_link_libraries(example_${name} PRIVATE ${pkgName})
        endif()
    endforeach()
endif()
